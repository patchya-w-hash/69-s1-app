{
  "kind": "collectionType",
  "collectionName": "leave_requests",
  "info": {
    "singularName": "leave-request",
    "pluralName": "leave-requests",
    "displayName": "Leave Request",
    "description": "Employee leave requests and approvals"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "leaveType": {
      "type": "enumeration",
      "enum": [
        "Sick",
        "Annual",
        "Personal",
        "Maternity",
        "Unpaid"
      ],
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "days": {
      "type": "decimal",
      "required": true
    },
    "reason": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "required": true
    },
    "employee": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::employee.employee",
      "inversedBy": "leaveRequests"
    },
    "approvedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::employee.employee"
    },
    "attachment": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    }
  }
}
