{
  "kind": "collectionType",
  "collectionName": "employees",
  "info": {
    "singularName": "employee",
    "pluralName": "employees",
    "displayName": "Employee",
    "description": "Employee profile and employment info"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "employeeId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "phone": {
      "type": "string"
    },
    "hireDate": {
      "type": "date",
      "required": true
    },
    "employmentType": {
      "type": "enumeration",
      "enum": [
        "FullTime",
        "PartTime",
        "Contract",
        "Intern"
      ],
      "default": "FullTime",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "Active",
        "Probation",
        "OnLeave",
        "Resigned",
        "Terminated"
      ],
      "default": "Active",
      "required": true
    },
    "salary": {
      "type": "decimal"
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "employees"
    },
    "position": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::position.position",
      "inversedBy": "employees"
    },
    "manager": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::employee.employee",
      "inversedBy": "subordinates"
    },
    "subordinates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::employee.employee",
      "mappedBy": "manager"
    },
    "leaveRequests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::leave-request.leave-request",
      "mappedBy": "employee"
    },
    "attendances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::attendance.attendance",
      "mappedBy": "employee"
    },
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
